# MCA Mail Configuration
# Copy this file to .env and adjust for your environment.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Observability: tracing level (info by default; RUST_LOG wins if set) and
# output format — pretty (terminal) or json (production/log collection).
# Set LOG_FORMAT=json on a server: json-file log rotation and any log shipper
# read one JSON object per line, and pretty output is not parseable.
LOG_LEVEL=info
LOG_FORMAT=pretty

DATABASE_URL=postgres://mca:mca@localhost:5432/mca_mail
DATABASE_MAX_CONNECTIONS=10
DATABASE_AUTO_MIGRATE=true

# Mailbox access mode. This is the safety switch, not a preference.
#   read_only - reads mail and writes freely to our own database (leads,
#               drafts, classification), but never sends, appends, moves,
#               copies, deletes, archives or changes flags on the mailbox.
#               This is the default and the safe choice.
#   read_write - additionally permits mailbox mutations (spam moves, the copy
#               into Sent, label changes). It does NOT enable automatic
#               sending: EMAIL_MODE/EMAIL_AUTO_SEND still decide that.
#   work      - legacy spelling of read_write, accepted for old .env files.
# An unrecognised value stops startup. It never falls back to write access.
MAIL_MODE=read_only

# PostgreSQL password, matching the user in DATABASE_URL above. docker-compose
# reads the same variable for both POSTGRES_PASSWORD and DATABASE_URL, so the
# two cannot drift apart. Keep DATABASE_URL and this in sync when editing.
POSTGRES_PASSWORD=mca

MAIL_PROVIDER=mock
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=implicit
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_INBOX=INBOX
MAIL_POLL_INTERVAL_SECONDS=300
# Folder convicted messages are moved into, by the exact name the server lists
# it. Empty falls back to the SPECIAL-USE \Junk role, which servers that do not
# advertise SPECIAL-USE (many do not) do not have.
MAIL_SPAM_FOLDER=
# Folder every delivered message is copied into with IMAP APPEND, by the exact
# name the server lists it — this is what makes a reply show up under
# "Отправленные" and not only on the wire. Empty falls back to the SPECIAL-USE
# \Sent role; servers that do not advertise SPECIAL-USE (many do not) need the
# name spelled out here.
MAIL_SENT_FOLDER=Sent
# IMAP IDLE (RFC 2177): ask the server to announce new mail instead of waiting
# for the poll above. Off by default, and only meaningful with MAIL_PROVIDER=imap
# on a server that advertises the capability.
#
# A poll interval still applies, and MAIL_IDLE_FALLBACK_POLL_SECONDS adds a
# second, slower one that runs only while IDLE is watching: IDLE is the fast
# path, the fallback is what keeps mail moving if the fast path dies silently.
MAIL_IDLE=false
# One IDLE session is ended and re-issued this often. 1740s is the RFC's 29
# minutes, short enough that an inactivity timeout cannot drop the connection.
MAIL_IDLE_WAIT_SECONDS=1740
# Reconnect schedule after a failed cycle: exponential from MIN, capped at MAX,
# each delay scattered by +/- JITTER% so several replicas do not retry as one.
MAIL_IDLE_BACKOFF_MIN_SECONDS=1
MAIL_IDLE_BACKOFF_MAX_SECONDS=300
MAIL_IDLE_JITTER_PERCENT=20
MAIL_IDLE_FALLBACK_POLL_SECONDS=90
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_TLS=starttls
MAIL_FROM_ADDRESS=
# Sender name shown on outbound mail. Note the name: MAIL_FROM_NAME, not
# MAIL_SMTP_FROM_NAME — anything else is read by nothing and silently ignored.
MAIL_FROM_NAME=MCA Logistics

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
# One model call may take well over a minute when the provider streams a long
# chain of thought; a 60s ceiling turns that into a retry storm. Production
# runs with 180.
LLM_TIMEOUT_SECONDS=60

AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=20
AGENT_TASK_TIMEOUT_SECONDS=180

# Outbound policy. Two gates must both be open before a reply is dispatched:
#   EMAIL_MODE=dry_run  - classify and draft, never touch the mailbox.
#   EMAIL_MODE=review   - let a human approve; auto-send stays off.
#   EMAIL_MODE=auto     - mailbox mutation allowed, and with
#   EMAIL_AUTO_SEND=true replies go out with no approval step.
EMAIL_MODE=dry_run
EMAIL_AUTO_SEND=false

# The manager card: one self-contained summary per qualified lead, delivered
# through the same outbox as replies (same rate limiter, same idempotency).
# Several managers: separate their addresses with commas —
#   MANAGER_CARD_RECIPIENT=first@x.com,second@y.com
# and each of them gets its own copy, its own hourly ceiling and its own
# delivery history. No address means the card is silently skipped.
SEND_MANAGER_CARD=false
MANAGER_CARD_RECIPIENT=
MANAGER_CARD_MAX_PER_HOUR=5

# PostgreSQL backups. These run regardless of MAIL_MODE: read-only protects the
# customer's mailbox, but our own leads, drafts and history are the only record
# of the work and would be lost with the disk.
BACKUP_ENABLED=true
# Inside Docker this must be a mounted volume, not a path inside the container,
# or the backups disappear with the container. See docker-compose.yml.
BACKUP_DIR=/app/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_MAX_SIZE_MB=1024
# Extra settings, safe defaults: how long a single pg_dump may run, and whether
# to take one at startup instead of waiting for the first interval.
BACKUP_COMMAND_TIMEOUT_SECONDS=600
BACKUP_RUN_ON_STARTUP=true

COMPANY_RESEARCH_ENABLED=false

RETENTION_DAYS=365