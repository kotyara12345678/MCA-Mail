# MCA Mail Configuration
# Copy this file to .env and adjust for your environment.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://mca:mca@localhost:5432/mca_mail
DATABASE_MAX_CONNECTIONS=10
DATABASE_AUTO_MIGRATE=true

MAIL_PROVIDER=mock
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_INBOX=INBOX
MAIL_POLL_INTERVAL_SECONDS=300
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_FROM_ADDRESS=
MAIL_SMTP_FROM_NAME=MCA Logistics

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=20
AGENT_TASK_TIMEOUT_SECONDS=180

EMAIL_MODE=dry_run
EMAIL_AUTO_SEND=false

COMPANY_RESEARCH_ENABLED=false

RETENTION_DAYS=365